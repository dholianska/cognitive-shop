{
  "ConnectionStrings": {
    "IdentityDb": "Server=127.0.0.1,14330;Database=IdentityDb;User Id=sa;Password=<set-in-user-secrets>;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "cognitive-shop-auth",
    "Audience": "cognitive-shop",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "AllowedHosts": "*"
}