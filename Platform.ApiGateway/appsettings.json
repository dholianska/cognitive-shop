{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": { "Path": "/api/aggregator/{**catch-all}" }
      },
      "orders": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "customers": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/customers/{**catch-all}" }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "categories": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "reviews": {
        "ClusterId": "reviews",
        "Match": { "Path": "/api/reviews/{**catch-all}" }
      }
    },
    "Clusters": {
      "aggregator": {
        "Destinations": {
          "d1": { "Address": "http://aggregator" }
        }
      },
      "orders": {
        "Destinations": {
          "d1": { "Address": "http://orders-api" }
        }
      },
      "catalog": {
        "Destinations": {
          "d1": { "Address": "http://catalog-api" }
        },
        "LoadBalancingPolicy": "RoundRobin"
      },
      "reviews": {
        "Destinations": {
          "d1": { "Address": "http://reviews-api" }
        }
      }
    }
  }
}